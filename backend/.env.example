GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
SESSION_SECRET=a_long_random_secret_string
PORT=3001
# Development only — not used in production (frontend is served from the same origin)
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
# Production: set NODE_ENV=production and update BACKEND_URL to your public URL
# Optional: path to system Chromium (if Puppeteer can't find Chrome)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
